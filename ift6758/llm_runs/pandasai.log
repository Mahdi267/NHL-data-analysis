# TODO: import the required dependencies
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Write code here

# Query to get average distance by shot type for season 2022-2023
sql_query = """
SELECT 
    shot_type,
    AVG(distance) AS avg_distance
FROM 
    table_f74ad33f7e7a75114e67eb2da2c7fe29
WHERE 
    season = '20222023'
    AND event_type = 'shot-on-goal'
GROUP BY 
    shot_type
ORDER BY 
    avg_distance DESC
"""

# Execute the SQL query
shot_data = execute_sql_query(sql_query)

# If no data is returned, return a string response
if shot_data.empty:
    result = {"type": "string", "value": "No shot data available for season 2022-2023."}
else:
    # Create a plot of average distance by shot type
    plt.figure(figsize=(10, 6))
    plt.bar(shot_data['shot_type'], shot_data['avg_distance'], color='skyblue')
    plt.title('Average Distance of Shots by Shot Type (Season 2022-2023)')
    plt.xlabel('Shot Type')
    plt.ylabel('Average Distance (feet)')
    plt.xticks(rotation=45)
    plt.tight_layout()
    
    # Save the plot to a file
    plot_path = "shot_distance_by_type.png"
    plt.savefig(plot_path)
    plt.close()
    
    result = {"type": "plot", "value": plot_path}

# Declare result variable
result
