# Query to calculate goal percentage for player 8480748 in the 2022-2023 season
# Goal percentage = (number of goals) / (number of shots on goal + goals)
sql_query = """
SELECT 
    COUNT(CASE WHEN event_type = 'goal' THEN 1 END) AS goals,
    COUNT(CASE WHEN event_type = 'shot-on-goal' THEN 1 END) AS shots_on_goal,
    (COUNT(CASE WHEN event_type = 'goal' THEN 1 END) * 1.0 / 
     (COUNT(CASE WHEN event_type = 'shot-on-goal' THEN 1 END) + COUNT(CASE WHEN event_type = 'goal' THEN 1 END))) AS goal_percentage
FROM 
    table_044b1ed43483ebcc02fb4a21ed4e5b9c
WHERE 
    shooter_id = 8480748 
    AND season = '20222023'
"""

