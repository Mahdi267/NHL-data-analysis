# TODO: import the required dependencies
import pandas as pd

# Write code here

# Query to calculate the combined goal percentage for all shot types except 'poke' in the 2020-2021 season
# Goal percentage = (number of goals) / (number of shots on goal)
# We exclude 'poke' shot type and filter for season 2020-2021

sql_query = """
SELECT 
    CAST(SUM(CASE WHEN event_type = 'goal' THEN 1 ELSE 0 END) AS FLOAT) * 1.0 / 
    COUNT(*) AS goal_percentage
FROM 
    table_f74ad33f7e7a75114e67eb2da2c7fe29
WHERE 
    season = '20202021'
    AND shot_type != 'poke'
    AND event_type IN ('goal', 'shot-on-goal')
"""

# Execute the query
result_df = execute_sql_query(sql_query)

# If the result is empty, return a string indicating no data
if result_df.empty:
    result = {"type": "string", "value": "No data available for the specified season and shot type exclusion."}
else:
    # Extract the goal percentage from the result
    goal_percentage = result_df.iloc[0]['goal_percentage']
    result = {"type": "number", "value": round(goal_percentage, 4)}

# Declare result variable
result
