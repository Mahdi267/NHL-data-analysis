# TODO: import the required dependencies
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Write code here

# Query to get the number of goals by strength for season 2016-2017
sql_query = """
SELECT 
    strength,
    COUNT(*) AS goal_count
FROM 
    table_044b1ed43483ebcc02fb4a21ed4e5b9c
WHERE 
    season = '20162017' 
    AND event_type = 'goal'
GROUP BY 
    strength
ORDER BY 
    goal_count DESC;
"""

# Execute the SQL query to get the data
goal_data = execute_sql_query(sql_query)

# Check if data is empty
if goal_data.empty:
    result = {
        "type": "string",
        "value": "No goals found for the season 2016-2017 with recorded strength data."
    }
else:
    # Create a figure and plot
    plt.figure(figsize=(10, 6))
    sns.barplot(data=goal_data, x='strength', y='goal_count', palette='viridis')
    plt.title('Number of Goals by Strength (Season 2016-2017)')
    plt.xlabel('Strength')
    plt.ylabel('Number of Goals')
    plt.xticks(rotation=45)
    
    # Save the plot to a file
    plot_path = "goal_count_by_strength.png"
    plt.tight_layout()
    plt.savefig(plot_path)
    plt.close()
    
    result = {
        "type": "plot",
        "value": plot_path
    }

# Declare result variable
result
