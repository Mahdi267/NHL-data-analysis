# TODO: import the required dependencies
import pandas as pd

# Write code here

# Query to find the goal percentage for backhand shots in the 2021-2022 season
# Goal percentage = (number of goals where shot_type = 'backhand') / (total number of backhand shots)
# We only consider rows where event_type is 'goal' or 'shot-on-goal' and shot_type is 'backhand'

sql_query = """
SELECT 
    CAST(SUM(CASE WHEN event_type = 'goal' THEN 1 ELSE 0 END) AS FLOAT) * 100.0 / 
    COUNT(*) AS goal_percentage
FROM 
    table_f74ad33f7e7a75114e67eb2da2c7fe29
WHERE 
    season = '20212022' 
    AND shot_type = 'backhand'
"""

# Execute the SQL query
result_df = execute_sql_query(sql_query)

# If no rows are found, return a string indicating that
if result_df.empty:
    result = {"type": "string", "value": "I cannot answer this question with the available data."}
else:
    # Extract the goal percentage from the result
    goal_percentage = result_df.iloc[0]['goal_percentage']
    result = {"type": "number", "value": round(goal_percentage, 2)}

# Declare result variable
result
