# TODO: import the required dependencies
import pandas as pd

# Write code here

# Query to calculate the combined goal percentage for all shot types except "poke" in the 2020-2021 season
# Goal percentage = (number of goals / total number of shots) * 100
# We filter for event_type = 'goal' for goals and exclude shot_type = 'poke'
# We only consider season = '20202021'

sql_query = """
SELECT 
    (COUNT(CASE WHEN event_type = 'goal' THEN 1 END) * 100.0 / COUNT(*)) AS goal_percentage
FROM 
    table_f74ad33f7e7a75114e67eb2da2c7fe29
WHERE 
    season = '20202021'
    AND shot_type != 'poke'
"""

# Execute the SQL query
result_df = execute_sql_query(sql_query)

# If no rows are returned, the result is a string indicating that the data is not available
if result_df.empty:
    result = {"type": "string", "value": "I cannot answer this question with the available data."}
else:
    # Extract the goal percentage as a number
    goal_percentage = result_df.iloc[0]['goal_percentage']
    result = {"type": "number", "value": round(goal_percentage, 2)}

# Declare result variable
result
