# TODO: import the required dependencies
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Write code here

# Query to get the number of shots on empty net for each shot type in the 2021-2022 season
sql_query = """
SELECT 
    shot_type,
    COUNT(*) AS shot_count
FROM 
    table_f74ad33f7e7a75114e67eb2da2c7fe29
WHERE 
    event_type = 'shot-on-goal' 
    AND emptyNet = True 
    AND season = '20212022'
GROUP BY 
    shot_type
ORDER BY 
    shot_count DESC;
"""

# Execute the SQL query to get the data
shot_data = execute_sql_query(sql_query)

# If no data is returned, return a string response
if shot_data.empty:
    result = {"type": "string", "value": "No shots on empty net were recorded for the 2021-2022 season."}
else:
    # Create a bar plot for shot types on empty net
    plt.figure(figsize=(10, 6))
    sns.barplot(data=shot_data, x='shot_type', y='shot_count', palette='viridis')
    plt.title('Number of Shots on Empty Net by Shot Type (2021-2022 Season)')
    plt.xlabel('Shot Type')
    plt.ylabel('Number of Shots')
    plt.xticks(rotation=45)
    plt.tight_layout()
    
    # Save the plot to a file
    plot_path = "shot_on_empty_net_by_type.png"
    plt.savefig(plot_path)
    plt.close()
    
    result = {"type": "plot", "value": plot_path}

# Declare result variable
result
