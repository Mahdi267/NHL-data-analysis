# TODO: import the required dependencies
import pandas as pd

# Write code here

# Query to calculate goal percentage for backhand shots in the 2021-2022 season
sql_query = """
SELECT 
    CAST(SUM(CASE WHEN event_type = 'goal' THEN 1 ELSE 0 END) AS FLOAT) * 100.0 / 
    COUNT(*) AS goal_percentage
FROM 
    table_044b1ed43483ebcc02fb4a21ed4e5b9c
WHERE 
    season = '20212022'
    AND shot_type = 'backhand'
"""

# Execute the query
result_df = execute_sql_query(sql_query)

# If no rows are returned, the goal percentage is 0
if result_df.empty or result_df.iloc[0]['goal_percentage'] is None:
    goal_percentage = 0.0
else:
    goal_percentage = result_df.iloc[0]['goal_percentage']

# Declare result variable
result = {
    "type": "number",
    "value": goal_percentage
}
