# TODO: import the required dependencies
import pandas as pd

# Write code here

# Query to find the goal percentage of player 8480748 in the 2022-2023 season
# Goal percentage = (number of goals / total number of shots) * 100
# We only consider rows where event_type is 'goal' for goals and 'shot-on-goal' for shots
# We filter by shooter_id = 8480748 and season = '20222023'

sql_query = """
SELECT 
    COUNT(CASE WHEN event_type = 'goal' THEN 1 END) * 100.0 / COUNT(*) AS goal_percentage
FROM 
    table_f74ad33f7e7a75114e67eb2da2c7fe29
WHERE 
    shooter_id = 8480748 
    AND season = '20222023'
    AND event_type IN ('goal', 'shot-on-goal')
"""

# Execute the query
result_df = execute_sql_query(sql_query)

# If no rows are found, the goal percentage is 0 (or we return a string indicating no data)
if result_df.empty:
    result = {"type": "string", "value": "I cannot answer this question with the available data."}
else:
    # Extract the goal percentage value
    goal_percentage = result_df.iloc[0]['goal_percentage']
    result = {"type": "number", "value": round(goal_percentage, 2)}

# Declare result variable
result
