# TODO: import the required dependencies
import pandas as pd

# Write code here

# Query to calculate the combined goal percentage for all games in the 2018-2019 season
# Goal percentage = (number of goals) / (number of shots on goal + goals)
# We need to count goals and shots on goal per game, then compute the percentage

sql_query = """
SELECT 
    game_id,
    COUNT(CASE WHEN event_type = 'goal' THEN 1 END) AS goals,
    COUNT(CASE WHEN event_type = 'shot-on-goal' THEN 1 END) AS shots_on_goal
FROM 
    table_f74ad33f7e7a75114e67eb2da2c7fe29
WHERE 
    season = '20182019'
GROUP BY 
    game_id
"""

# Execute the query
game_stats = execute_sql_query(sql_query)

# Calculate goal percentage for each game
game_stats['goal_percentage'] = game_stats['goals'] / (game_stats['goals'] + game_stats['shots_on_goal'])

# Sum up the goal percentages across all games to get the combined goal percentage
combined_goal_percentage = game_stats['goal_percentage'].sum()

# Declare result variable
result = {
    "type": "number",
    "value": combined_goal_percentage
}
