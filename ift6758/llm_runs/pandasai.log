# TODO: import the required dependencies
import pandas as pd

# Write code here

# Query to calculate the combined goal percentage for all games of the 2018-2019 season
# Goal percentage = (total goals / total shots) * 100
# We need to count goals (event_type = 'goal') and total shots (event_type = 'shot-on-goal') per game
# Then compute the goal percentage for each game and sum them up across all games

sql_query = """
SELECT 
    SUM(CASE WHEN event_type = 'goal' THEN 1 ELSE 0 END) * 100.0 / 
    (SUM(CASE WHEN event_type = 'goal' THEN 1 ELSE 0 END) + 
     SUM(CASE WHEN event_type = 'shot-on-goal' THEN 1 ELSE 0 END)) AS combined_goal_percentage
FROM 
    table_f74ad33f7e7a75114e67eb2da2c7fe29
WHERE 
    season = '20182019'
"""

# Execute the SQL query
result_df = execute_sql_query(sql_query)

# Since the question asks for the combined goal percentage for all games of the 2018-2019 season,
# and we are not summing percentages across games (as per instructions), we return the single value.

# If the result is empty, we return a string indicating we cannot answer
if result_df.empty:
    result = {"type": "string", "value": "I cannot answer this question with the available data."}
else:
    # Extract the value from the result
    combined_percentage = result_df.iloc[0]['combined_goal_percentage']
    result = {"type": "number", "value": round(combined_percentage, 4)}

# Declare result variable
result
