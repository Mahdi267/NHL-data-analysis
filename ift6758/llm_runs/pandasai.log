sql_query = """
SELECT 
    CAST(SUM(CASE WHEN event_type = 'goal' THEN 1 ELSE 0 END) AS FLOAT) * 100.0 / 
    COUNT(*) AS goal_percentage
FROM 
    table_044b1ed43483ebcc02fb4a21ed4e5b9c
WHERE 
    season = '20212022'
    AND shot_type = 'backhand'
"""

