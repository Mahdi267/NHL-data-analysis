    "   \"source\": [\n",
    "    \"def interactive_shot_map(shot_map):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    :param shot_map: ShotMap object\\n\",\n",
    "    \"    :return: Creates html interactive figure ?\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # checks if shot_map has kdes, if not, calls shot_map.calculate_kde()\\n\",\n",
    "    \"    if len(shot_map.kdes) == 0:\\n\",\n",
    "    \"        shot_map.calculate_kdes()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    df = shot_map.shots\\n\",\n",
    "    \"    # For now not the right data\\n\",\n",
    "    \"    coords = df[\\\"shots\\\"][0] #For initialisation of the figure\\n\",\n",
    "    \"    # coords = shot_map.kdes[0]\\n\",\n",
    "    \"    team_list = df[\\\"team\\\"].drop_duplicates()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    teams = []\\n\",\n",
    "    \"    for i in range(len(team_list)):\\n\",\n",
    "    \"        it = dict(label = team_list[i], args=[{\\\"z\\\": shot_map.kdes}], method=\\\"restyle\\\")\\n\",\n",
    "    \"        teams.append(it)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # CODE TAKEN FROM PLOTLY DEMO\\n\",\n",
    "    \"    # create figure\\n\",\n",
    "    \"    fig = go.Figure()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add surface trace\\n\",\n",
    "    \"    fig.add_trace(go.Heatmap(z=coords.values.tolist(), colorscale=\\\"Viridis\\\")) #TODO Changed code\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Update plot sizing\\n\",\n",
    "    \"    fig.update_layout(\\n\",\n",
    "    \"        width=800,\\n\",\n",
    "    \"        height=900,\\n\",\n",
    "    \"        autosize=False,\\n\",\n",
    "    \"        margin=dict(t=0, b=0, l=0, r=0),\\n\",\n",
    "    \"        template=\\\"plotly_white\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Update 3D scene options\\n\",\n",
    "    \"    fig.update_scenes(\\n\",\n",
    "    \"        aspectratio=dict(x=1, y=1, z=0.7),\\n\",\n",
    "    \"        aspectmode=\\\"manual\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add dropdown\\n\",\n",
    "    \"    fig.update_layout(\\n\",\n",
    "    \"        updatemenus=[\\n\",\n",
    "    \"            dict(\\n\",\n",
    "    \"                buttons = teams, #Changed code here\\n\",\n",
    "    \"                direction=\\\"down\\\",\\n\",\n",
    "    \"                pad={\\\"r\\\": 10, \\\"t\\\": 10},\\n\",\n",
    "    \"                showactive=True,\\n\",\n",
    "    \"                x=0.1,\\n\",\n",
    "    \"                xanchor=\\\"left\\\",\\n\",\n",
    "    \"                y=1.1,\\n\",\n",
    "    \"                yanchor=\\\"top\\\"\\n\",\n",
    "    \"            ),\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add annotation\\n\",\n",
    "    \"    fig.update_layout(\\n\",\n",
    "    \"        annotations=[\\n\",\n",
    "    \"            dict(text=\\\"Team:\\\", showarrow=False,\\n\",\n",
    "    \"            x=0, y=1.085, yref=\\\"paper\\\", align=\\\"left\\\")\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # From demo in blog template\\n\",\n",
    "    \"    # fig.write_html(\\\"../../figures/interactive_figure.html\\\", include_plotlyjs=\\\"cdn\\\", full_html=False)\\n\",\n",
    "    \"    fig.show()\"\n",
