    "   \"id\": \"463ed142b0de794d\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 📊 What is the visualization about?\\n\",\n",
    "    \"We want to create a shot chart for a given NHL team, showing the location of its shots on the ice to visualize shooting patterns and identify areas of offensive strength.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"50b659ea7809d7b4\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import scipy.stats as stats\\n\",\n",
    "    \"from ift6758.features.simple_visualizations import games_list\\n\",\n",
    "    \"import plotly.graph_objects as go\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"4bc2aa9e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"- `number_games()` calculates the number of games played by each team during a given season.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 2,\n",
    "   \"id\": \"2c700ed0\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def number_games(season) -> dict:\\n\",\n",
    "    \"    # Get all the games dataframe\\n\",\n",
    "    \"    df_games = games_list(season, events=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Keep regular season and playoffs only (game type code in the game id)\\n\",\n",
    "    \"    df_games = df_games[df_games[\\\"game_type\\\"].isin([2, 3])]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate the number of game for each team\\n\",\n",
    "    \"    number_games_per_team = {}\\n\",\n",
    "    \"    for game in df_games.itertuples():\\n\",\n",
    "    \"        homeTeam_id = getattr(game, \\\"homeTeam_name\\\")\\n\",\n",
    "    \"        awayTeam_id = getattr(game, \\\"awayTeam_name\\\")\\n\",\n",
    "    \"        number_games_per_team[homeTeam_id] = number_games_per_team.get(homeTeam_id, 0) + 1\\n\",\n",
    "    \"        number_games_per_team[awayTeam_id] = number_games_per_team.get(awayTeam_id, 0) + 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return number_games_per_team\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"07c4a96b\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"- `shot_data` contains all the information needed to generate the desired visualization. It returns a DataFrame containing, for each team, its name, the number of games played during the season, and the coordinates of every shot and goal recorded throughout the season.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 3,\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true\n",
    "   },\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"                  team  games  \\\\\\n\",\n",
    "      \"0    New Jersey Devils     94   \\n\",\n",
    "      \"1   New York Islanders     88   \\n\",\n",
    "      \"2     New York Rangers     89   \\n\",\n",
    "      \"3  Philadelphia Flyers     82   \\n\",\n",
    "      \"4  Pittsburgh Penguins     82   \\n\",\n",
    "      \"\\n\",\n",
    "      \"                                               shots  \\n\",\n",
    "      \"0           725    727    731    735    736    73...  \\n\",\n",
    "      \"1           859    860    861    862    865    86...  \\n\",\n",
    "      \"2           115    116    118    122    123    12...  \\n\",\n",
    "      \"3           724    726    728    729    730    73...  \\n\",\n",
    "      \"4           643    644    646    647    649    65...  \\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"def shot_data(season):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Gets the data from json (possibly by calling the distance function) for the season and extracts the shot coordinates to a more usable format\\n\",\n",
    "    \"    :param season: 4 digit year of the season start\\n\",\n",
    "    \"    :return: a dataframe containing each team's name, number of games, and an array of x,y shot coordinates (1 line per shot, columns x and y)\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Get each team's number of games\\n\",\n",
    "    \"    team_game_number = number_games(season)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Link each team_id to its abbrev\\n\",\n",
    "    \"    df_games = games_list(season, events=False)\\n\",\n",
    "    \"    id_to_abbrev = {}\\n\",\n",
    "    \"    for game in df_games.itertuples():\\n\",\n",
    "    \"        id_to_abbrev[getattr(game, \\\"homeTeam_id\\\")] = getattr(game, \\\"homeTeam_name\\\")\\n\",\n",
    "    \"        id_to_abbrev[getattr(game, \\\"awayTeam_id\\\")] = getattr(game, \\\"awayTeam_name\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Get the shots and goals dataframe for the given season\\n\",\n",
    "    \"    df_events = games_list(season)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Keep regular season and playoffs\\n\",\n",
    "    \"    df_shots = df_events[\\n\",\n",
    "    \"        df_events[\\\"game_type\\\"].isin([\\\"regular season\\\", \\\"playoffs\\\"])\\n\",\n",
    "    \"    ].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Put all the shots on the same side (use same logic as distance() from simple_visualization.py)\\n\",\n",
    "    \"    home_shoots = df_shots[\\\"team_id\\\"] == df_shots[\\\"homeTeam_id\\\"]\\n\",\n",
    "    \"    attacks_left = np.where(\\n\",\n",
    "    \"        home_shoots,\\n\",\n",
    "    \"        df_shots[\\\"homeTeamDefendingSide\\\"] == \\\"right\\\",\\n\",\n",
    "    \"        df_shots[\\\"homeTeamDefendingSide\\\"] == \\\"left\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Flip the shots by 180°­­­­ if they were taken from the left side of the pitch\\n\",\n",
    "    \"    df_shots.loc[attacks_left, [\\\"x_coord\\\", \\\"y_coord\\\"]] *= -1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rows = []\\n\",\n",
    "    \"    for team_id, df_team in df_shots.groupby(\\\"team_id\\\"):\\n\",\n",
    "    \"        team = id_to_abbrev[team_id]\\n\",\n",
    "    \"        rows.append({\\n\",\n",
    "    \"            \\\"team\\\": team,\\n\",\n",
    "    \"            \\\"games\\\": team_game_number[team],\\n\",\n",
    "    \"            \\\"shots\\\": df_team[[\\\"x_coord\\\", \\\"y_coord\\\"]].T\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return pd.DataFrame(rows)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(shot_data(2022).head())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 4,\n",
