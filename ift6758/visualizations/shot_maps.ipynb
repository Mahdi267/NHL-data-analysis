    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"def kde():\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Calculates kde when given an array of shot coordinates\\n\",\n",
    "    \"    :return: shot density\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 5,\n",
    "   \"id\": \"edbabbaeb22f0ed5\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"class ShotMap:\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __init__(self, season):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"        :param season: 4 digit year of the season start\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        self.season = season\\n\",\n",
    "    \"        self.shots = shot_data(season)\\n\",\n",
    "    \"        self.kdes = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def calculate_kdes1(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        This calculates league average shot rate per hour (league_sph) and excess shot rate per hour for each team, in the form of shot density using kde. Also saves raw difference in shots per team hour\\n\",\n",
    "    \"        :return:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        # first, calculate kde for league average and save the factor, which will be given to the team kdes\\n\",\n",
    "    \"        coords_league = np.ndarray(self.shots[\\\"shots\\\"])\\n\",\n",
    "    \"        print(\\\"LEAGUE COORDS: \\\" + coords_league)\\n\",\n",
    "    \"        #for team_coords in self.shots[\\\"shots\\\"]:\\n\",\n",
    "    \"        #    coords_league.append((team_coords[\\\"x_coord\\\"], team_coords[\\\"y_coord\\\"]))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for team_coords in self.shots[\\\"shots\\\"]:\\n\",\n",
    "    \"            print(team_coords)\\n\",\n",
    "    \"            coords_league.append(team_coords)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        self.league_kde = self.kdes.append(stats.gaussian_kde(pd.concat(coords_league)))\\n\",\n",
    "    \"        factor = self.league_kde.covariance_factor()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # calculate shot rate per hour density for each team using kde:\\n\",\n",
    "    \"        for team_coords in self.shots[\\\"shots\\\"]:\\n\",\n",
    "    \"            self.kdes.append(stats.gaussian_kde(team_coords, bw_method=factor))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # densities will need to be weighed by shot rate\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # convert teams' sph to excess sph using league average\\n\",\n",
    "    \"        # calculate raw difference in shots per team hour\\n\",\n",
    "    \"        self.shot_rate = []\\n\",\n",
    "    \"        for team_coords in self.shots[\\\"shots\\\"]:\\n\",\n",
    "    \"            self.shot_rate.append(team_coords.shape[1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def calculate_kdes(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        This calculates league average shot rate per hour (league_sph) and excess shot rate per hour for each team, in the form of shot density using kde. Also saves raw difference in shots per team hour\\n\",\n",
    "    \"        :return:\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        # first, calculate kde for league average and save the factor, which will be given to the team kdes\\n\",\n",
    "    \"        #for team_coords in self.shots[\\\"shots\\\"]:\\n\",\n",
    "    \"        #    coords_league.append((team_coords[\\\"x_coord\\\"], team_coords[\\\"y_coord\\\"]))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        self.league_kde = stats.gaussian_kde(pd.concat(self.shots.iloc[2,:].values, axis=1))\\n\",\n",
    "    \"        factor = self.league_kde.covariance_factor()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # calculate shot rate per hour density for each team using kde:\\n\",\n",
    "    \"        for index, team in self.shots.items():\\n\",\n",
    "    \"            self.kdes.append(stats.gaussian_kde(team[\\\"shots\\\"].values, bw_method=factor))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # densities will need to be weighed by shot rate\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # convert teams' sph to excess sph using league average\\n\",\n",
    "    \"        # calculate raw difference in shots per team hour\\n\",\n",
    "    \"        self.shot_rate = np.array([self.shots.shape[1],1], dtype=int)\\n\",\n",
    "    \"        self.league_sn = 0\\n\",\n",
    "    \"        self.league_hrs = 0\\n\",\n",
    "    \"        for ind, team in self.shots.items():\\n\",\n",
    "    \"            self.shot_rate[ind] = (team[\\\"shots\\\"].values.shape[1] / (2*team[\\\"games\\\"]) )\\n\",\n",
    "    \"            self.league_sn += team[\\\"shots\\\"].values.shape[1]\\n\",\n",
    "    \"            self.league_hrs += (2*team[\\\"games\\\"])\\n\",\n",
    "    \"        print(\\\"league shot number \\\" + str(self.league_sr))\\n\"\n",
    "   ],\n",
