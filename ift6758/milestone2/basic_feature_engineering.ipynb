    "# Histogram of goal rate according to distance\n",
    "\n",
    "sog = angles_df[angles_df[\"event_type\"]==\"shot-on-goal\"][\"distance\"]\n",
    "goal = angles_df[angles_df[\"event_type\"]==\"goal\"][\"distance\"]\n",
    "min = np.min((np.min(sog), np.min(goal)))\n",
    "max = np.max((np.max(sog), np.max(goal)))\n",
    "no_goals_hist, bins = np.histogram(sog, 50, range=(min,max))\n",
    "goals_hist, bins = np.histogram(goal, 50, range=(min,max))\n",
    "\n",
    "plt.plot( bins[:-1], goals_hist/(goals_hist+no_goals_hist), label = \"Goal rate\")\n",
    "\n",
    "plt.legend()\n",
    "plt.xlabel(\"Distance (m)\")\n",
    "plt.ylabel(\"Goal rate\")\n",
    "plt.title(f\"Goal Rate According to Distance for {train_years[0]}-{train_years[-1]}\")\n",
    "plt.savefig(\"q2_rate_dist.png\")\n",
    "plt.show()"
